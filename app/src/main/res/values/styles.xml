<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Default theme for Activities that show normal Android UI (home,
         install, uninstall, distro info). Material3 DayNight gives us
         automatic light/dark theming; the accent (colorPrimary) is a
         warm orange that drives Install/Open buttons. Destructive
         actions opt out of the accent and use @color/tawc_danger. -->
    <style name="Theme.Tawc" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>

        <item name="colorPrimary">@color/tawc_accent</item>
        <item name="colorOnPrimary">@color/tawc_on_tonal</item>
        <item name="colorPrimaryContainer">@color/tawc_accent</item>
        <item name="colorOnPrimaryContainer">@color/tawc_on_tonal</item>

        <item name="colorError">@color/tawc_danger</item>
        <item name="colorOnError">@color/tawc_on_danger</item>

        <!-- Override the Material3 default surface so the page is a
             muted grey rather than near-white/near-black. Cards then
             pick the opposite extreme (white in light mode, near-black
             in dark) to read as their own surface. -->
        <item name="android:windowBackground">@color/tawc_window_bg</item>
        <item name="colorSurface">@color/tawc_window_bg</item>

        <!-- Tint the system bars to the window surface so the
             accent doesn't bleed into the status bar. windowLightStatusBar
             flips icons to dark for light mode; values-night/styles.xml
             overrides it back to false for dark mode. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="TextAppearance.Tawc.HomeTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Home drawer and ⋮ popup: the app's neutral surfaces and an
         accent-tinted selection instead of Material3's lavender
         containers. Applied as overlays so dialogs keep their look. -->
    <style name="ThemeOverlay.Tawc.Surfaces" parent="">
        <item name="colorSurfaceContainerLow">@color/tawc_card_bg</item>
        <item name="colorSurfaceContainer">@color/tawc_card_bg</item>
        <item name="colorSecondaryContainer">@color/tawc_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/tawc_on_tonal</item>
        <item name="navigationViewStyle">@style/Widget.Tawc.NavigationView</item>
    </style>

    <!-- Selected-row pill at the app's 6dp button corners
         (BUTTON_CORNER_DP in ui/Scaffold.kt), not Material3's full round. -->
    <style name="Widget.Tawc.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemShapeAppearanceOverlay">@style/ShapeAppearance.Tawc.NavItem</item>
    </style>

    <style name="ShapeAppearance.Tawc.NavItem" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="Theme.Tawc.Launcher" parent="Theme.Tawc">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">@drawable/tawc_popup_bg</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>

    <!-- Host theme for activities that only show a dialog
         (LaunchErrorActivity): the window itself is invisible; the
         MaterialAlertDialog provides the surface and dim. -->
    <style name="Theme.Tawc.DialogHost" parent="Theme.Tawc">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Compositor activity stays on the device-default theme: it draws
         its own surface and never inflates Material widgets, so pulling
         Material3 in here would just bloat the resource table for no win.
         Fullscreen is toggled at runtime from xdg_toplevel state. -->
    <style name="Theme.Tawc.Compositor" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
